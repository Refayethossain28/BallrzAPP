{
  "manifest_version": 3,
  "name": "NoteMark",
  "version": "1.0.0",
  "description": "Highlight text and pin sticky notes on any page. Annotations are saved per URL and restored when you return.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NoteMark — annotations on this page",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
