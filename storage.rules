rules_version = '2';

// Firebase Storage rules. Secure-by-default: deny everything except the paths
// explicitly allowed below.
service firebase.storage {
  match /b/{bucket}/o {

    // Ripple message media (photos / voice notes) live under ripple/<chatId>/…
    // Any signed-in user may read (download URLs are unguessable and only ever
    // shared inside a chat the recipient is a member of) and upload reasonably
    // sized files. Tighten further with a Cloud Function check against chat
    // membership before a public launch if you need hard isolation.
    match /ripple/{chatId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|audio/.*');
    }

    // Atlas dashcam submissions: a signed-in user may stage their own clip
    // (owner-only path, video only, 200MB cap) for the atlasClipPublish
    // Cloud Function, which pushes it to YouTube unlisted and deletes it.
    // No client reads — the staging area is write-only.
    match /atlas_clips/{uid}/{fileName} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource != null
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }
  }
}
